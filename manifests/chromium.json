{
  "manifest_version": 3,
  "name": "Social Comment Cleaner",
  "version": "0.3.1",
  "description": "Reliably clean your own comments on social platforms. Starts with TikTok Web.",
  "permissions": ["storage", "tabs", "windows"],
  "host_permissions": ["*://*.tiktok.com/*"],
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Social Comment Cleaner",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/sw.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.tiktok.com/*", "*://tiktok.com/*"],
      "js": [
        "lib/browser-api.js",
        "content/shared.js",
        "content/platforms/tiktok.js",
        "content/controller.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
