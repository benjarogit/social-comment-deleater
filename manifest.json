{
  "manifest_version": 2,
  "name": "Social Comment Cleaner",
  "version": "0.3.2",
  "description": "Reliably clean your own comments on social platforms. Starts with TikTok Web.",
  "browser_specific_settings": {
    "gecko": {
      "id": "social-comment-cleaner@local.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "*://*.tiktok.com/*"
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Social Comment Cleaner",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["lib/browser-api.js", "background/background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://www.tiktok.com/*", "*://tiktok.com/*"],
      "js": [
        "lib/browser-api.js",
        "content/shared.js",
        "content/platforms/tiktok.js",
        "content/controller.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
